# X Layer mainnet (chain 196) — Uniswap v4 canonical deployment lives here.
# Public RPCs (rotate if rate-limited):
#   https://rpc.xlayer.tech                (official)
#   https://xlayerrpc.okx.com              (OKX)
#   https://196.rpc.thirdweb.com           (thirdweb proxy)
XLAYER_RPC_URL=https://rpc.xlayer.tech

# X Layer testnet (chain 1952, Terigon). 100 req/sec/IP cap.
# Faucet (claim 0.2 OKB/day): https://web3.okx.com/xlayer/faucet/xlayerfaucet
# Block explorer:             https://www.okx.com/web3/explorer/xlayer-test
#   https://testrpc.xlayer.tech/terigon    (official)
#   https://xlayertestrpc.okx.com/terigon  (OKX)
XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon

# OKLink API key for contract verification on X Layer.
# Get one at: https://www.oklink.com/account/my-api
OKLINK_API_KEY=

# Deployer private key (preferred: `cast wallet import deployer --interactive` keystore, then pass --account)
DEPLOYER_PRIVATE_KEY=

# Token pair for the demo pool (X Layer mainnet addresses)
# Filled in once we pick the pair (likely WETH/USDC or WETH/USDT)
TOKEN0=
TOKEN1=
