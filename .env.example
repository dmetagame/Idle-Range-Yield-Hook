# X Layer mainnet (chain 196) — Uniswap v4 canonical deployment lives here.
# Public RPCs (rotate if rate-limited):
#   https://rpc.xlayer.tech
#   https://xlayerrpc.okx.com
#   https://196.rpc.thirdweb.com
XLAYER_RPC_URL=https://rpc.xlayer.tech

# X Layer testnet (chain 195) — no canonical v4 deployment as of 2026-05.
# Only useful if we deploy our own PoolManager (out of scope for hackathon MVP).
XLAYER_TESTNET_RPC_URL=https://195.rpc.thirdweb.com

# OKLink API key for contract verification on X Layer.
# Get one at: https://www.oklink.com/account/my-api
OKLINK_API_KEY=

# Deployer private key (preferred: use `cast wallet import` keystore instead, then pass --account)
DEPLOYER_PRIVATE_KEY=

# Token pair for the demo pool (X Layer mainnet addresses)
# Filled in once we pick the pair (likely WETH/USDC or WETH/USDT)
TOKEN0=
TOKEN1=
